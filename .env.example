# StatementIQ Configuration
# Copy this file to .env and adjust values

# Tesseract OCR path (required for scanned PDFs)
# Windows: typically C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler path (required for scanned PDFs - pdf2image)
# Windows: download from https://github.com/oschwartz10612/poppler-windows/releases
POPPLER_PATH=C:\poppler-26.09.0\Library\bin

# Upload settings
MAX_UPLOAD_MB=25

# Classification
CONFIDENCE_THRESHOLD=0.75

# Data retention
RETENTION_ENABLED=false

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
DATABASE_URL=sqlite:///./statementiq.db

